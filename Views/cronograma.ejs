<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cronograma</title>
</head>
<body>
    <h1>tanto faz</h1>
     <table border="1">
            <% for (let exercicios of locals.usuarioExercicios) { %>
                <tr>
                <th> nome exercicio </th>
                <th> intensidade exercicio </th>
                </tr> 
                <tr>
                <td> <%= exercicios.descricao %> </td>
                <td> <%= exercicios.intensidade %> </td>
                </tr>   
            <% } %>
            </table>

    <h2><%= gastoRepouso %> kcal/dia</h2>
        <form action="/cronograma" method="POST">
           <div>
            <% for (let dia of locals.resultadoDia){ %>
            <%= dia.dia%>
            <% } %>
           </div>
        </form>

</body>
</html>